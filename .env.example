APP_NAME=FrCenter
APP_ENV=development
APP_SECRET_KEY=change_me

DATABASE_URL=postgresql+asyncpg://frcenter:password@localhost:5432/frcenter
REDIS_URL=redis://localhost:6379/0

SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=your_email@mail.ru
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@mail.ru
SMTP_USE_SSL=true

MEDIA_STORAGE_PATH=./backend/app/storage
MESSAGE_TTL_SECONDS=7200
AUTO_CREATE_TABLES=false

FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS_CSV=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
FRONTEND_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|10\\.\\d+\\.\\d+\\.\\d+|192\\.168\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d+\\.\\d+|26\\.\\d+\\.\\d+\\.\\d+)(?::\\d+)?$
BACKEND_URL=http://localhost:8000
